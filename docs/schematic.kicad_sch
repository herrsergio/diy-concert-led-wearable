  ;; ============ TEXT NOTES ============
  (text "NOTES:\n1. R1 (470 ohm) must be placed close to WS2812B DIN pin\n2. C1 (1000uF) across LED strip +5V/GND prevents inrush damage\n3. INMP441 L/R tied to GND = left channel (matches firmware config)\n4. Buttons use ESP32 internal pull-up (INPUT_PULLUP), no external resistors\n5. For breadboard testing: power from USB-C on ESP32 DevKit\n6. For wearable: add battery section (BT1 + U3 + U4 + SW3)"
    (at 40.64 144.78 0)
    (effects (font (size 1.27 1.27)))
  )

  (text "POWER SECTION (Phase 4 - Wearable Build)\n18650 (3.7V) -> TP4056 (charge/protect) -> MT3608 (boost to 5V) -> SW3 -> System 5V\nEstimated runtime: ~3.3h at 40% brightness (900mA avg draw)"
    (at 40.64 157.48 0)
    (effects (font (size 1.27 1.27)))
  )
)
