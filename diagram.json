{
  "version": 1,
  "author": "Music LED Strip",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-s3-devkitc-1",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-neopixel-strip",
      "id": "strip1",
      "top": -150,
      "left": -100,
      "attrs": {
        "pixels": "30"
      }
    },
    {
      "type": "wokwi-neopixel-strip",
      "id": "strip2",
      "top": -120,
      "left": -100,
      "attrs": {
        "pixels": "30"
      }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_mode",
      "top": 100,
      "left": -150,
      "attrs": {
        "color": "orange",
        "label": "MODE"
      }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_bright",
      "top": 100,
      "left": -50,
      "attrs": {
        "color": "yellow",
        "label": "BRIGHT"
      }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": -80,
      "left": -50,
      "attrs": {
        "value": "470"
      }
    }
  ],
  "connections": [
    ["esp:GND.1", "strip1:GND", "black", ["v:20"]],
    ["esp:5V", "strip1:VDD", "red", ["v:10"]],
    ["esp:38", "r1:1", "green", ["h:0"]],
    ["r1:2", "strip1:DIN", "green", ["h:0"]],
    ["strip1:DOUT", "strip2:DIN", "green", ["h:10"]],
    ["esp:5V", "strip2:VDD", "red", ["v:10"]],
    ["esp:GND.1", "strip2:GND", "black", ["v:20"]],
    ["esp:4", "btn_mode:1.l", "orange", ["h:0"]],
    ["btn_mode:2.l", "esp:GND.1", "black", ["h:0"]],
    ["esp:5", "btn_bright:1.l", "orange", ["h:0"]],
    ["btn_bright:2.l", "esp:GND.1", "black", ["h:0"]]
  ]
}
